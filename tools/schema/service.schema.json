{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (provider-service)"
        },
        "name": {
          "type": "string",
          "description": "Display name"
        },
        "provider": {
          "type": "string",
          "description": "Provider name"
        },
        "category": {
          "type": "string",
          "enum": ["compute", "database", "storage", "cdn-edge", "serverless", "devtools", "communication", "ai-ml", "creative", "web3"],
          "description": "Category"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Official service page"
        },
        "free_tier": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["always-free", "time-limited-trial", "credits", "mixed"],
              "description": "Type of free tier"
            },
            "always_free": {
              "type": "object",
              "properties": {
                "included": {
                  "type": "boolean"
                },
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "duration": {
                  "type": "string"
                }
              },
              "required": ["included"]
            },
            "time_limited": {
              "type": "object",
              "properties": {
                "included": {
                  "type": "boolean"
                },
                "duration_days": {
                  "type": ["integer", "null"]
                },
                "description": {
                  "type": ["string", "null"]
                }
              },
              "required": ["included"]
            },
            "credits": {
              "type": "object",
              "properties": {
                "included": {
                  "type": "boolean"
                },
                "amount": {
                  "type": "string"
                },
                "duration_days": {
                  "type": "integer"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["included"]
            }
          },
          "required": ["type"]
        },
        "regions": {
          "type": "object",
          "properties": {
            "always_free": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "gotchas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "best_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complementary_services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "service_id": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["service_id", "notes"]
          }
        },
        "cost": {
          "type": "object",
          "properties": {
            "under_free_tier": {
              "type": "string"
            },
            "typical_after_free": {
              "type": "string"
            },
            "scaling_trajectory": {
              "type": "string"
            }
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "credit_card": {
              "type": "boolean"
            },
            "phone_verification": {
              "type": "boolean"
            },
            "identity_verification": {
              "type": "boolean"
            },
            "minimum_age": {
              "type": "integer"
            },
            "geography_restrictions": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "official_docs": {
              "type": "string",
              "format": "uri"
            },
            "free_tier_page": {
              "type": "string",
              "format": "uri"
            },
            "tutorial": {
              "type": "string",
              "format": "uri"
            },
            "community": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "last_verified": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "YYYY-MM-DD"
            },
            "verified_by": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": ["last_verified", "verified_by", "source"]
        },
        "flags": {
          "type": "object",
          "properties": {
            "time_sensitive": {
              "type": "boolean"
            },
            "cost_risk": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "vendor_lock_in": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "learning_curve": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "setup_time": {
              "type": "integer",
              "description": "Minutes to get first instance running"
            }
          },
          "required": ["time_sensitive", "cost_risk", "vendor_lock_in", "learning_curve", "setup_time"]
        }
      },
      "required": ["id", "name", "provider", "category", "url", "free_tier", "regions", "gotchas", "best_for", "not_for", "complementary_services", "cost", "requirements", "resources", "metadata", "flags"]
    }
  },
  "required": ["service"]
}